# Server Configuration
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database Configuration
# For local Docker: mongodb://localhost:27017/learnquest
# For production: mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/learnquest
REDIS_URL=redis://localhost:6379

# JWT Config
JWT_ACCESS_SECRET=learnquest_super_secret_access_key_12345
JWT_REFRESH_SECRET=learnquest_super_secret_refresh_key_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS Configuration (Optional: falls back to local file system upload if blank)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=learnquest-public-assets
AWS_S3_PRIVATE_BUCKET=learnquest-private-assets
AWS_CLOUDFRONT_URL=https://d111111abcdef8.cloudfront.net

# SMTP Configuration (Emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=LearnQuest India <no-reply@learnquest.in>

# AI Configuration (Optional: falls back to local NLP tutor logic if blank)
AI_PROVIDER=openai
AI_API_KEY=your-openai-or-gemini-key
AI_MODEL=gpt-4-turbo

# Security Configuration
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging & Monitoring
SENTRY_DSN=
LOG_LEVEL=info
