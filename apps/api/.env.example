# Server Configuration
NODE_ENV=production
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=
REDIS_URL=redis://localhost:6379

# JWT Config
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS Configuration (Blank triggers fallback to local uploads)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PRIVATE_BUCKET=
AWS_CLOUDFRONT_URL=

# Resend Configuration (Blank logs emails to console)
RESEND_API_KEY=
SMTP_FROM=LearnQuest India <onboarding@resend.dev>

# AI Configuration (Blank triggers fallback to local rule-based tutor)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Security Configuration
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173

# Logging & Monitoring
LOG_LEVEL=info
